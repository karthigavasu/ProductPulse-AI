# GEMINI_API_KEY: Required for optional Gemini AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin passcode override.
# Leave unset to claim the first admin account directly in the UI.
ADMIN_PASSCODE=""

# DATABASE_PATH: Optional path to the SQLite database file.
DATABASE_PATH="./data/productpulse.db"
